# Tier 5 negative case 5 — malformed schema: a box size missing a value.
# `block` is a box primitive whose `size` has only two of the three values
# [x, y, z]. PartsBuilder._box_size() must raise PartsBuilderError saying
# exactly three values are expected, not an IndexError/unpacking error when
# the third is later read.
# See docs/developer/VALIDATION_STRENGTHENING.md section 3, Tier 5.
schema_version: "3.0"

metadata:
  name: N5 Malformed Schema
  description: "Negative test: box size has 2 values instead of [x, y, z]"

parts:
  block:
    primitive: box
    size: [10, 10]   # z intentionally omitted

export:
  default_part: block
